# Copia este archivo a .env.local y ajusta los valores

# URL base del backend Flask.
# NOTA: Next.js inyecta esta variable en el MOMENTO DEL BUILD, así que en
# producción (Vercel) se configura en el panel y cualquier cambio exige
# volver a desplegar.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# NOTA: los datos de la empresa (nombre, NIF, teléfono, dirección y logo)
# se configuran en frontend/lib/empresa.ts, no aquí.
