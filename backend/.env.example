# Copia este archivo a .env y ajusta los valores si lo necesitas

# Base de datos (por defecto sqlite:///database.sqlite dentro de instance/)
# DATABASE_URI=sqlite:///database.sqlite

# true activa el modo debug de Flask (solo en local, nunca en producción)
DEBUG=false

# Puerto de desarrollo
PORT=5000

# Orígenes permitidos para el frontend, separados por comas
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Autenticación (JWT)
# ---------------------------------------------------------------------------

# Clave usada para firmar los tokens. Obligatoria en producción.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Usuario administrador del login
ADMIN_USER=admin

# Hash de la contraseña (NUNCA guardes la contraseña en claro).
# Genera el hash con:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu_password'))"
# ADMIN_PASSWORD_HASH=

# Caducidad del token en minutos (por defecto 12 horas)
JWT_EXPIRA_MINUTOS=720

# Intentos de login fallidos permitidos por minuto e IP
LOGIN_MAX_INTENTOS=5
